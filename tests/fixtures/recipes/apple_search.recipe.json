{
  "kind": "dom",
  "allowed_hosts": ["jobs.apple.com"],
  "verification": {
    "expected_count": 20,
    "sample_titles": ["US - Specialist: Seasonal, Part-time", "MBA Internships"],
    "url_pattern": "^https://jobs\\.apple\\.com/en-us/details/\\d+(-\\d+)?/[^/?]+(\\?team=[A-Z]+)?$"
  },
  "container": "li[data-core-accordion-item]:has(h3 a)",
  "link": {"selector": "h3 a", "attr": "href"},
  "title": {"selector": "h3 a"},
  "location": {"selector": "span.table--advanced-search__location-sub"}
}
