": "enqueue_careers_search_run_runs_careers_search_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunCareersSearchRequest"}}}, "required": true}, "responses": {"202": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunQueuedResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/runs/name-collect": {"post": {"summary": "Enqueue Name Collect Run", "description": "Queue a name collection over the owner's pasted listing URLs (M1 B3).\n\nEnqueue-only: this creates the run, one ``sources`` row per URL and the\nper-source ``run_sources`` manifest. The worker owns all fetching,\nreplaying, authoring and candidate writes.", "operationId": "enqueue_name_collect_run_runs_name_collect_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunNameCollectRequest"}}}, "required": true}, "responses": {"202": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunQueuedResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/runs": {"get": {"summary": "Runs", "operationId": "runs_runs_get", "parameters": [{"name": "status", "in": "query", "required": false, "schema": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Status"}}, {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "maximum": 200, "minimum": 1, "default": 50, "title": "Limit"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/RunResponse"}, "title": "Response Runs Runs Get"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/runs/{run_id}": {"get": {"summary": "Run", "operationId": "run_runs__run_id__get", "parameters": [{"name": "run_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Run Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/runs/{run_id}/cancel": {"post": {"summary": "Cancel Run", "operationId": "cancel_run_runs__run_id__cancel_post", "parameters": [{"name": "run_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Run Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunCancelResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/runs/{run_id}/pause": {"post": {"summary": "Pause Run", "description": "Pause a run at its next checkpoint; a paused run holds its type slot.", "operationId": "pause_run_runs__run_id__pause_post", "parameters": [{"name": "run_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Run Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunControlResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/runs/{run_id}/resume": {"post": {"summary": "Resume Run", "operationId": "resume_run_runs__run_id__resume_post", "parameters": [{"name": "run_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Run Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunControlResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/runs/{run_id}/sources": {"get": {"summary": "Run Sources", "description": "The run's per-company/per-source manifest, in selection order.", "operationId": "run_sources_runs__run_id__sources_get", "parameters": [{"name": "run_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Run Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/RunSourceOut"}, "title": "Response Run Sources Runs  Run Id  Sources Get"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/profile": {"get": {"summary": "Get User Profile", "operationId": "get_user_profile_profile_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProfileResponse"}}}}}}, "put": {"summary": "Put User Profile", "operationId": "put_user_profile_profile_put", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProfileUpdateRequest"}}}, "required": true}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProfileResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/profile/evidence": {"get": {"summary": "Get User Evidence", "description": "Read the ``user_evidence`` document.\n\nThere is no full-replace endpoint on purpose (Phase 4.1a invariant (c)):\nthe only way structured evidence enters the DB is