# OpenRouter API key (sk-or-v1-...): https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Paid search backend (default since 2026-11-09): https://api.search.brave.com/
BRAVE_SEARCH_KEY=...
OPENROUTER_ANALYSIS_MODEL=gpt-4o-mini
OPENROUTER_APPLICATION_MODEL=openai/gpt-4o
# Optional: set only if using a custom LLM provider endpoint
# LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MIN_INTERVAL_SECONDS=2
LLM_MAX_RETRIES=2
LLM_CACHE_DIR=data/cache
DATABASE_URL=sqlite:///data/jobs.db
EVIDENCE_PATH=data/evidence.yaml
